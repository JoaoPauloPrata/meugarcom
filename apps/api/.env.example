# Copie para .env (gitignored). Em produção, use os secrets do host (Fly.io).
OPENAI_API_KEY=sk-...
# Opcional: habilita o fallback Anthropic configurado em ai_model_settings
ANTHROPIC_API_KEY=
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave secreta do Supabase (sb_secret_... ou service_role legada): upload das fotos dos itens no Storage
SUPABASE_SERVICE_ROLE_KEY=
# Papel dedicado meugarcom_api (menor privilégio), pelo pooler do Supabase (session mode)
ConnectionStrings__Database=Host=aws-0-REGIAO.pooler.supabase.com;Port=5432;Database=postgres;Username=meugarcom_api.SEU-PROJETO;Password=...;SSL Mode=Require
CORS_ORIGINS=http://localhost:5173
